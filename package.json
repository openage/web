{
  "name": "pages-app",
  "version": "2.4.0",
  "scripts": {
    "ng": "ng",
    "local": "ng serve -c=local --open --port 4210",
    "dev": "ng serve -c=dev --open --port 4210",
    "qa": "ng serve -c=qa --open --port 4210",
    "prod": "node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng serve -c=production --open --port 4210",
    "build:local": "node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build -c=local",
    "build:dev": "node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build -c=dev",
    "build:qa": "node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build -c=qa",
    "build:prod": "node --max_old_space_size=8048 ./node_modules/@angular/cli/bin/ng build -c=production",
    "test": "ng test",
    "lint": "ng lint --fix oa",
    "lint:log": "ng lint --format stylish > lint.log",
    "e2e": "ng e2e",
    "analysis": "ng build && source-map-explorer dist/build/main.bundle.js",
    "serve:ssr:oa": "node dist/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "@angular/youtube-player": "^21.0.0",
    "express": "^4.18.2",
    "font-awesome": "^4.7.0",
    "handlebars": "^4.7.8",
    "marked": "^15.0.12",
    "moment": "^2.30.1",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/schematics": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/express": "^4.17.21",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.56.0",
    "postcss": "^8.5.4",
    "typescript": "~5.9.0"
  }
}